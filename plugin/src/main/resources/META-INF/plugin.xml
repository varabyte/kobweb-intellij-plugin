<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Product and plugin compatibility requirements. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.plugins.gradle</depends>

    <!-- Extension points defined by the plugin. -->
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                instance="com.varabyte.kobweb.intellij.settings.KobwebSettingsConfigurable"
                id="com.varabyte.kobweb.settings.framework"
                displayName="Kobweb"
                parentId="language"/>

        <spellchecker.bundledDictionaryProvider implementation="com.varabyte.kobweb.intellij.spellcheck.KobwebBundledDictionaryProvider" />

        <postStartupActivity implementation="com.varabyte.kobweb.intellij.startup.KobwebPostStartupProjectActivity" />

        <projectService
                serviceInterface="com.varabyte.kobweb.intellij.services.project.KobwebProjectCacheService"
                serviceImplementation="com.varabyte.kobweb.intellij.services.project.KobwebProjectCacheServiceImpl"/>

        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.varabyte.kobweb.intellij.lineMarkers.ExtractCssStyleRefactorLineMarkerProvider" />

        <lang.inspectionSuppressor language="kotlin" implementationClass="com.varabyte.kobweb.intellij.inspections.supressors.FunctionNameInspectionSuppressor"/>
        <lang.inspectionSuppressor language="kotlin" implementationClass="com.varabyte.kobweb.intellij.inspections.supressors.UnusedInspectionSuppressor"/>
        <localInspection
                language="kotlin"
                displayName="Kobweb top-level style enforcement"
                groupName="Kobweb"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.TopLevelStyleSingletonsInspection"/>
        <localInspection
                language="kotlin"
                displayName="Kobweb public style enforcement"
                groupName="Kobweb"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.PrivateStyleSingletonsInspection"/>

        <colorProvider implementation="com.varabyte.kobweb.intellij.colors.KobwebColorProvider" />
        <annotator language="kotlin" implementationClass="com.varabyte.kobweb.intellij.annotations.AttrModifierFunctionAnnotator"/>

        <notificationGroup displayType="BALLOON" id="Kobweb" />

        <platform.backend.documentation.psiTargetProvider
                order="before KotlinDocumentationTargetProvider"
                implementation="com.varabyte.kobweb.intellij.docs.WebModifierDocumentationTargetProvider"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve implementation="com.varabyte.kobweb.intellij.project.KobwebGradleProjectResolver" />
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>
</idea-plugin>
