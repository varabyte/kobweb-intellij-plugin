<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Product and plugin compatibility requirements. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.plugins.gradle</depends>

    <resource-bundle>bundles.KobwebBundle</resource-bundle>

    <actions>
        <group id="Kobweb.RefactorActionGroup"
               popup="true"
               icon="/assets/icons/kobweb16.svg">

            <action id="Kobweb.ExtractCssStyle"
                    class="com.varabyte.kobweb.intellij.actions.style.ExtractCssStyleAction"/>
        </group>

        <group id="Kobweb.RefactoringMenu">
            <reference ref="Kobweb.RefactorActionGroup"/>
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                instance="com.varabyte.kobweb.intellij.settings.KobwebSettingsConfigurable"
                id="com.varabyte.kobweb.settings.framework"
                key="kobweb.name"
                parentId="language"/>

        <spellchecker.bundledDictionaryProvider implementation="com.varabyte.kobweb.intellij.spellcheck.KobwebBundledDictionaryProvider" />

        <postStartupActivity implementation="com.varabyte.kobweb.intellij.startup.KobwebPostStartupProjectActivity" />

        <projectService
                serviceInterface="com.varabyte.kobweb.intellij.services.project.KobwebProjectCacheService"
                serviceImplementation="com.varabyte.kobweb.intellij.services.project.KobwebProjectCacheServiceImpl"/>

        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.varabyte.kobweb.intellij.lineMarkers.style.ExtractCssStyleRefactorLineMarkerProvider" />
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.varabyte.kobweb.intellij.lineMarkers.icons.SilkIconLineMarkerProvider" />

        <lang.inspectionSuppressor language="kotlin" implementationClass="com.varabyte.kobweb.intellij.inspections.supressors.FunctionNameInspectionSuppressor"/>
        <lang.inspectionSuppressor language="kotlin" implementationClass="com.varabyte.kobweb.intellij.inspections.supressors.UnusedInspectionSuppressor"/>
        <customUsageSearcher implementation="com.varabyte.kobweb.intellij.findUsages.worker.WorkerFactoryUsageSearcher"/>
        <!-- This processor is registered with `order="last"`, so that the Kotlin plugin's own processor still handles renaming the factory class itself. -->
        <renamePsiElementProcessor implementation="com.varabyte.kobweb.intellij.rename.worker.WorkerFactoryRenameProcessor" order="last"/>
        <!-- The Kotlin plugin's processor is also registered with `order="first"`, so we register with `order="first, before KotlinClass"`. Otherwise, plugin load order determines which wins. -->
        <renamePsiElementProcessor implementation="com.varabyte.kobweb.intellij.rename.worker.SynthesizedWorkerClassRenameProcessor" order="first, before KotlinClass"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.top.level.style.singletons.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.style.TopLevelStyleSingletonsInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.private.style.singletons.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.style.PrivateStyleSingletonsInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.attribute.modifier.in.style.sheet.block.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.style.AttributeModifierInStyleSheetBlockInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.dangling.modifier.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.modifier.DanglingModifierInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.remember.worker.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.worker.RememberWorkerInspection"/>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.style.ExtractCssStyleIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.style.format.ConvertStyleToConciseFormatIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.style.format.ConvertStyleToExpandedFormatIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <colorProvider implementation="com.varabyte.kobweb.intellij.colors.KobwebColorProvider" />
        <codeInsight.declarativeInlayProvider
                implementationClass="com.varabyte.kobweb.intellij.inlay.KobwebModifierInlayHintsProvider"
                language="kotlin"
                providerId="kobweb.modifier.hints"
                nameKey="kobweb.inlay.hints.name"
                isEnabledByDefault="true"
                group="OTHER_GROUP"
                bundle="bundles.KobwebBundle">
            <option
                    optionId="kobweb.modifier.hints.attr"
                    bundle="bundles.KobwebBundle"
                    nameKey="kobweb.inlay.hints.modifier.attr.name"
                    descriptionKey="kobweb.inlay.hints.modifier.attr.desc"
                    enabledByDefault="true"
            />
            <option
                    optionId="kobweb.modifier.hints.style"
                    bundle="bundles.KobwebBundle"
                    nameKey="kobweb.inlay.hints.modifier.style.name"
                    descriptionKey="kobweb.inlay.hints.modifier.style.desc"
                    enabledByDefault="false"
            />
        </codeInsight.declarativeInlayProvider>

        <notificationGroup displayType="BALLOON" id="Kobweb"/>

        <platform.backend.documentation.psiTargetProvider
                order="before KotlinDocumentationTargetProvider"
                implementation="com.varabyte.kobweb.intellij.docs.WebModifierDocumentationTargetProvider"/>

        <!-- https://blog.jetbrains.com/platform/2026/10/ui-freeze-reports-in-marketplace/ -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve implementation="com.varabyte.kobweb.intellij.project.KobwebGradleProjectResolver" />
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
        <kaResolveExtensionProvider implementation="com.varabyte.kobweb.intellij.resolve.worker.WorkerResolveExtensionProvider" />
    </extensions>
</idea-plugin>
