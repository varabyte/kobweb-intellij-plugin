<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Product and plugin compatibility requirements. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.plugins.gradle</depends>
    <!-- Used to read .kobweb/conf.yaml files. Features that need it are skipped if it's disabled -->
    <depends optional="true" config-file="kobweb-withYaml.xml">org.jetbrains.plugins.yaml</depends>
    <!-- Used to apply Kobweb's schema to .kobweb/conf.yaml files (which also needs the YAML plugin, which depends on it) -->
    <depends optional="true" config-file="kobweb-withJson.xml">com.intellij.modules.json</depends>

    <resource-bundle>bundles.KobwebBundle</resource-bundle>

    <actions>
        <group id="Kobweb.RefactorActionGroup"
               popup="true"
               icon="/assets/icons/kobweb16.svg">

            <action id="Kobweb.ExtractCssStyle"
                    class="com.varabyte.kobweb.intellij.actions.style.ExtractCssStyleAction"/>
        </group>

        <group id="Kobweb.RefactoringMenu">
            <reference ref="Kobweb.RefactorActionGroup"/>
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </group>

        <!-- Extra inlay hint options (check code for logic around conditions they show up under) -->
        <action id="Kobweb.ChooseLayoutForPage"
                class="com.varabyte.kobweb.intellij.inlay.ChooseLayoutForPageAction">
            <add-to-group group-id="InlayMenu"/>
        </action>
        <action id="Kobweb.OptOutOfDefaultLayout"
                class="com.varabyte.kobweb.intellij.inlay.OptOutOfDefaultLayoutAction">
            <add-to-group group-id="InlayMenu"/>
        </action>
        <action id="Kobweb.ConfigureInlayHints"
                class="com.varabyte.kobweb.intellij.inlay.ConfigureKobwebInlayHintsAction">
            <add-to-group group-id="InlayMenu"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                instance="com.varabyte.kobweb.intellij.settings.KobwebSettingsConfigurable"
                id="com.varabyte.kobweb.settings.framework"
                key="kobweb.name"
                parentId="language"/>

        <spellchecker.bundledDictionaryProvider implementation="com.varabyte.kobweb.intellij.spellcheck.KobwebBundledDictionaryProvider" />

        <postStartupActivity implementation="com.varabyte.kobweb.intellij.startup.KobwebPostStartupProjectActivity" />

        <projectService
                serviceInterface="com.varabyte.kobweb.intellij.services.project.KobwebProjectCacheService"
                serviceImplementation="com.varabyte.kobweb.intellij.services.project.KobwebProjectCacheServiceImpl"/>

        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.varabyte.kobweb.intellij.lineMarkers.style.ExtractCssStyleRefactorLineMarkerProvider" />
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.varabyte.kobweb.intellij.lineMarkers.icons.SilkIconLineMarkerProvider" />

        <lang.inspectionSuppressor language="kotlin" implementationClass="com.varabyte.kobweb.intellij.inspections.supressors.FunctionNameInspectionSuppressor"/>
        <lang.inspectionSuppressor language="kotlin" implementationClass="com.varabyte.kobweb.intellij.inspections.supressors.UnusedInspectionSuppressor"/>
        <customUsageSearcher implementation="com.varabyte.kobweb.intellij.findUsages.api.ApiRouteUsageSearcher"/>
        <customUsageSearcher implementation="com.varabyte.kobweb.intellij.findUsages.route.PageRouteUsageSearcher"/>
        <customUsageSearcher implementation="com.varabyte.kobweb.intellij.findUsages.worker.WorkerFactoryUsageSearcher"/>
        <!-- This processor is registered with `order="last"`, so that the Kotlin plugin's own processor still handles renaming the factory class itself. -->
        <renamePsiElementProcessor implementation="com.varabyte.kobweb.intellij.rename.worker.WorkerFactoryRenameProcessor" order="last"/>
        <!-- The Kotlin plugin's processor is also registered with `order="first"`, so we register with `order="first, before KotlinClass"`. Otherwise, plugin load order determines which wins. -->
        <renamePsiElementProcessor implementation="com.varabyte.kobweb.intellij.rename.worker.SynthesizedWorkerClassRenameProcessor" order="first, before KotlinClass"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.top.level.style.singletons.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.style.TopLevelStyleSingletonsInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.private.style.singletons.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.style.PrivateStyleSingletonsInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.attribute.modifier.in.style.sheet.block.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.style.AttributeModifierInStyleSheetBlockInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.dangling.modifier.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.modifier.DanglingModifierInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.remember.worker.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.worker.RememberWorkerInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.invalid.layout.path.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.layout.InvalidLayoutPathInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.invalid.default.layout.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.layout.InvalidDefaultLayoutInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.redundant.layout.display.name"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.layout.RedundantLayoutInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.conflicting.layout.annotations.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.layout.ConflictingLayoutAnnotationsInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.invalid.route.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.route.InvalidRouteInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.invalid.route.format.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.route.InvalidRouteFormatInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.invalid.api.path.format.display.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.varabyte.kobweb.intellij.inspections.api.InvalidApiPathFormatInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.unknown.api.path.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.api.UnknownApiPathInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.page.route.not.allowed.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.route.PageRouteNotAllowedInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.redirected.page.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.route.RedirectedPageInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.redirected.route.display.name"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.route.RedirectedRouteInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.redundant.route.display.name"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.route.RedundantRouteInspection"/>
        <localInspection
                language="kotlin"
                groupKey="kobweb.name"
                key="inspection.unknown.route.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.varabyte.kobweb.intellij.inspections.route.UnknownRouteInspection"/>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.style.ExtractCssStyleIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.style.format.ConvertStyleToConciseFormatIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.style.format.ConvertStyleToExpandedFormatIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.layout.ChangeLayoutIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <intentionAction>
            <className>com.varabyte.kobweb.intellij.intentions.layout.OptOutOfDefaultLayoutIntention</className>
            <categoryKey>kobweb.name</categoryKey>
            <language>kotlin</language>
        </intentionAction>
        <psi.referenceContributor
                language="kotlin"
                implementation="com.varabyte.kobweb.intellij.references.layout.LayoutPathReferenceContributor"/>
        <gotoDeclarationHandler
                implementation="com.varabyte.kobweb.intellij.references.layout.LayoutPathGotoDeclarationHandler"/>
        <psi.referenceContributor
                language="kotlin"
                implementation="com.varabyte.kobweb.intellij.references.route.RouteReferenceContributor"/>
        <psi.referenceContributor
                language="kotlin"
                implementation="com.varabyte.kobweb.intellij.references.api.ApiPathReferenceContributor"/>
        <refactoring.elementListenerProvider
                implementation="com.varabyte.kobweb.intellij.references.layout.LayoutMoveListenerProvider"/>
        <!-- Must run before Kotlin's, which suppresses auto-popups in all strings -->
        <completion.confidence
                language="kotlin"
                id="kobwebLayoutPathCompletionConfidence"
                order="before kotlinSkipAutopopupInStrings"
                implementationClass="com.varabyte.kobweb.intellij.completion.layout.LayoutPathCompletionConfidence"/>
        <!-- Must run before Kotlin's, which suppresses auto-popups in all strings -->
        <completion.confidence
                language="kotlin"
                id="kobwebRouteCompletionConfidence"
                order="before kotlinSkipAutopopupInStrings"
                implementationClass="com.varabyte.kobweb.intellij.completion.route.RouteCompletionConfidence"/>
        <!-- Must run before Kotlin's, which suppresses auto-popups in all strings -->
        <completion.confidence
                language="kotlin"
                id="kobwebApiPathCompletionConfidence"
                order="before kotlinSkipAutopopupInStrings"
                implementationClass="com.varabyte.kobweb.intellij.completion.api.ApiPathCompletionConfidence"/>
        <!-- Runs first, so that it can stop IntelliJ from suggesting file paths in routes -->
        <completion.contributor
                language="kotlin"
                order="first"
                implementationClass="com.varabyte.kobweb.intellij.completion.route.RouteCompletionContributor"/>
        <!-- Runs first, so that it can stop IntelliJ from suggesting file paths in API paths -->
        <completion.contributor
                language="kotlin"
                order="first"
                implementationClass="com.varabyte.kobweb.intellij.completion.api.ApiPathCompletionContributor"/>
        <typedHandler implementation="com.varabyte.kobweb.intellij.completion.route.RouteTypedHandler"/>
        <annotator
                language="kotlin"
                implementationClass="com.varabyte.kobweb.intellij.highlighting.route.DynamicRouteSegmentAnnotator"/>
        <lang.foldingBuilder
                language="kotlin"
                implementationClass="com.varabyte.kobweb.intellij.folding.PercentEncodedStringFoldingBuilder"/>
        <codeFoldingOptionsProvider instance="com.varabyte.kobweb.intellij.settings.KobwebCodeFoldingOptionsProvider"/>
        <colorSettingsPage implementation="com.varabyte.kobweb.intellij.highlighting.KobwebColorSettingsPage"/>
        <colorProvider implementation="com.varabyte.kobweb.intellij.colors.KobwebColorProvider" />
        <codeInsight.declarativeInlayProvider
                implementationClass="com.varabyte.kobweb.intellij.inlay.KobwebModifierInlayHintsProvider"
                language="kotlin"
                providerId="kobweb.modifier.hints"
                nameKey="kobweb.inlay.hints.name"
                isEnabledByDefault="true"
                group="OTHER_GROUP"
                bundle="bundles.KobwebBundle">
            <option
                    optionId="kobweb.modifier.hints.attr"
                    bundle="bundles.KobwebBundle"
                    nameKey="kobweb.inlay.hints.modifier.attr.name"
                    descriptionKey="kobweb.inlay.hints.modifier.attr.desc"
                    enabledByDefault="true"
            />
            <option
                    optionId="kobweb.modifier.hints.style"
                    bundle="bundles.KobwebBundle"
                    nameKey="kobweb.inlay.hints.modifier.style.name"
                    descriptionKey="kobweb.inlay.hints.modifier.style.desc"
                    enabledByDefault="false"
            />
        </codeInsight.declarativeInlayProvider>
        <codeInsight.declarativeInlayProvider
                implementationClass="com.varabyte.kobweb.intellij.inlay.KobwebAnnotationInlayHintsProvider"
                language="kotlin"
                providerId="kobweb.annotation.hints"
                nameKey="kobweb.inlay.hints.annotations.name"
                isEnabledByDefault="true"
                group="ANNOTATIONS_GROUP"
                bundle="bundles.KobwebBundle">
            <option
                    optionId="kobweb.annotation.hints.default.layout"
                    bundle="bundles.KobwebBundle"
                    nameKey="kobweb.inlay.hints.annotations.default.layout.name"
                    descriptionKey="kobweb.inlay.hints.annotations.default.layout.desc"
                    enabledByDefault="true"
            />
        </codeInsight.declarativeInlayProvider>
        <codeInsight.declarativeInlayProvider
                implementationClass="com.varabyte.kobweb.intellij.inlay.KobwebPageRouteInlayHintsProvider"
                language="kotlin"
                providerId="kobweb.page.route.hints"
                nameKey="kobweb.inlay.hints.page.route.name"
                descriptionKey="kobweb.inlay.hints.page.route.desc"
                isEnabledByDefault="true"
                group="URL_PATH_GROUP"
                bundle="bundles.KobwebBundle"/>

        <notificationGroup displayType="BALLOON" id="Kobweb"/>

        <platform.backend.documentation.psiTargetProvider
                order="before KotlinDocumentationTargetProvider"
                implementation="com.varabyte.kobweb.intellij.docs.WebModifierDocumentationTargetProvider"/>

        <!-- https://blog.jetbrains.com/platform/2026/10/ui-freeze-reports-in-marketplace/ -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve implementation="com.varabyte.kobweb.intellij.project.KobwebGradleProjectResolver" />
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
        <kaResolveExtensionProvider implementation="com.varabyte.kobweb.intellij.resolve.worker.WorkerResolveExtensionProvider" />
        <!-- Registered with the Kotlin plugin's rename handlers, rather than IntelliJ's, so that it takes priority over them instead of IntelliJ asking the user which one to use. -->
        <renameHandler implementation="com.varabyte.kobweb.intellij.rename.route.RouteRenameHandler" order="first"/>
    </extensions>
</idea-plugin>
