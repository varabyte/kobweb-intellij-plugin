<!-- Features that are only available when IntelliJ's Gradle DSL plugin is enabled (see the optional dependency in plugin.xml) -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- A module builder rather than a newProjectWizard.generator, which only shows up in the New Project dialog -->
        <moduleBuilder builderClass="com.varabyte.kobweb.intellij.wizards.module.KobwebNewProjectWizard$Builder"/>
    </extensions>
</idea-plugin>
