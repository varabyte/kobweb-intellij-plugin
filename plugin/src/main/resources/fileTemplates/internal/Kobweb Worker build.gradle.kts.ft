plugins {
    alias(${KOTLIN_MULTIPLATFORM_PLUGIN})
    alias(${KOBWEB_WORKER_PLUGIN})
    ${SERIALIZATION_COMMENT}alias(${KOTLINX_SERIALIZATION_PLUGIN})
